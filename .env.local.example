# Локальное окружение — скопируй в .env.local и заполни CHANGE-ME
# Запуск: make up-local (добавляет compose.local.yml с auth2api)

# ─── LiteLLM core ────────────────────────────────────────────────────────────
LITELLM_MASTER_KEY=sk-master-CHANGE-ME
LITELLM_SALT_KEY=sk-salt-CHANGE-ME
LITELLM_DB_PASSWORD=litellm-CHANGE-ME
LITELLM_API_KEY=CHANGE-ME

# LiteLLM доступен снаружи Docker на localhost
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MCP_URL=http://localhost:4000/mcp/

# ─── SBT AI Hub (модели компании) ────────────────────────────────────────────
SBT_API_BASE_URL=https://api.ai.sbt/openai/v1
AI_HUB_SBT_KEY=CHANGE-ME

# ─── auth2api (Claude OAuth прокси) ──────────────────────────────────────────
# Запущен в Docker-сети, litellm обращается к нему по имени сервиса
AUTH2API_BASE_URL=http://auth2api:8317/v1

# ─── Vault (локальный Docker-сайдкар) ────────────────────────────────────────
VAULT_LOCAL_PATH=/path/to/your/vault
VAULT_LOCAL_MCP_URL=http://vault-mcp:8080/mcp

# ─── SC local (пишет артефакты в локальный клон репозитория) ─────────────────
# Путь к локальному клону репо, куда воркер пишет артефакты (например, vcs-api)
SC_LOCAL_PATH=/path/to/local/repo-clone
# SC_LOCAL_MCP_URL не нужен — compose берёт sc-local-mcp:8081 по умолчанию

# ─── Worker / Temporal ───────────────────────────────────────────────────────
# TEMPORAL_NAMESPACE и DEFAULT_MODEL генерируются из config.local.yml
TEMPORAL_ADDRESS=temporal:7233
WORKER_LITELLM_BASE_URL=http://litellm:4000
# VAULT_MCP_URL не нужен в локалке — compose берёт vault-mcp:8080 по умолчанию
SC_BASE_URL=https://sc.example.com
SC_TOKEN=CHANGE-ME

# ─── Observability (опционально) ─────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
OTEL_EXPORTER_OTLP_ENDPOINT=
