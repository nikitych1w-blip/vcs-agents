# Прод-окружение — скопируй в .env.prod и заполни CHANGE-ME
# Запуск: make up (базовый стек без auth2api)

# ─── LiteLLM core ────────────────────────────────────────────────────────────
LITELLM_MASTER_KEY=sk-master-CHANGE-ME
LITELLM_SALT_KEY=sk-salt-CHANGE-ME
LITELLM_DB_PASSWORD=litellm-CHANGE-ME
LITELLM_API_KEY=CHANGE-ME

# В проде LiteLLM может быть за reverse proxy
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MCP_URL=http://localhost:4000/mcp/

# ─── SBT AI Hub (модели компании) ────────────────────────────────────────────
SBT_API_BASE_URL=https://api.ai.sbt/openai/v1
AI_HUB_SBT_KEY=CHANGE-ME

# ─── Vault (удалённый MCP) ───────────────────────────────────────────────────
VAULT_MCP_URL=https://vault.example.com/mcp
VAULT_MCP_TOKEN=CHANGE-ME

# ─── Worker / Temporal ───────────────────────────────────────────────────────
TEMPORAL_ADDRESS=temporal:7233
WORKER_LITELLM_BASE_URL=http://litellm:4000
SC_BASE_URL=https://sc.example.com
SC_TOKEN=CHANGE-ME

# ─── Observability (опционально) ─────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
OTEL_EXPORTER_OTLP_ENDPOINT=
